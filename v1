                code = self._arm.set_servo_angle(angle=[97.1, 18.6, 62.6, 1.3, 43.6, 135.0], speed=self._angle_speed, mvacc=self._angle_acc, wait=True, radius=0.0)
                if not self._check_code(code, 'set_servo_angle'):
                    return
                ##### Python code #####
                print("i = ", self._vars['i'])
                #######################
                if (self._vars.get('i', 0)) <= (2):
                    self._vars['pick_y'] += 45
                    self._vars['place_y'] += 40
                elif (self._vars.get('i', 0)) == (3):
                    self._vars['pick_x'] += 70
                    self._vars['pick_y'] += -90
                    self._vars['place_y'] += -60
                    self._vars['place_z'] += 15
                elif (self._vars.get('i', 0)) == (4):
                    self._vars['pick_y'] += 45
                    self._vars['place_y'] += 40
                else:
                    self._vars['pick_y'] += 45
                    self._vars['place_y'] += -20
                    self._vars['place_z'] += 15
                if (self._vars.get('i', 0)) > (5):
                    break
                self._vars['i'] += 1
                interval = time.monotonic() - t1
                if interval < 0.01:
                    time.sleep(0.01 - interval)
            code = self._arm.stop_lite6_gripper()
            if not self._check_code(code, 'stop_lite6_gripper'):
                return
            code = self._arm.set_cgpio_digital(0, 0, delay_sec=0, sync=True)
