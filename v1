                code = self._arm.set_servo_angle(angle=[-42.8, 21.5, 86.7, -0.1, 65.0, 45.9], speed=self._angle_speed, mvacc=self._angle_acc, wait=False, radius=0.0)
                if not self._check_code(code, 'set_servo_angle'):
                    return
                code = self._arm.set_position(*[231.2, -214.7, 255.0, -179.9, 0.0, -86.5], speed=self._tcp_speed, mvacc=self._tcp_acc, radius=0.0, wait=True)
                if not self._check_code(code, 'set_position'):
                    return
                code = self._arm.stop_lite6_gripper()
