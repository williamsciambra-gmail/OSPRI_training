                    return
                code = self._arm.set_position(z=-35, radius=-1, speed=self._tcp_speed, mvacc=self._tcp_acc, relative=True, wait=True)
                if not self._check_code(code, 'set_position'):
                    return
                code = self._arm.open_lite6_gripper()
