                code = self._arm.set_position(*[242.1, 245.3, 223.5, 179.2, 2.6, -40.0], speed=self._tcp_speed, mvacc=self._tcp_acc, radius=0.0, wait=True)
                if not self._check_code(code, 'set_position'):
