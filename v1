                code = self._arm.set_position(*[-69.7,self._vars.get('place_y', 0),238.2,-179.6,-0.1,0.4], speed=self._tcp_speed, mvacc=self._tcp_acc, radius=0, wait=True)
                if not self._check_code(code, 'set_position'):
